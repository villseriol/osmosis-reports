<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <report-list>
    <report alias="character-group-frequency" format="yaml" output-path="%OUTPUT_PATH_CHARACTER_GROUP_FREQUENCY_YAML%">
      <tag-list>
        <tag key="name" />
        <tag key="name:en" />
        <tag key="name:ja" />
        <tag key="name:ja-Hira" />
        <tag key="name:ko" />
        <tag key="operator" />
      </tag-list>
    </report>
    <report alias="character-frequency" format="csv" output-path="%OUTPUT_PATH_CHARACTER_FREQUENCY_CSV%">
      <tag-list>
        <tag key="name" />
        <tag key="name:en" />
        <tag key="name:ja" />
        <tag key="name:ja-Hira" />
        <tag key="name:ko" />
        <tag key="operator" />
      </tag-list>
    </report>
  </report-list>
</configuration>
